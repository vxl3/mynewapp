// ============================================================
// احجزلي — PostgreSQL schema (Phase 1: complete data foundation)
// Booking business logic is intentionally NOT implemented yet.
// Every table required by future phases is normalized and ready.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------
// Enums
// ------------------------------------------------------------

enum RoleName {
  CUSTOMER
  BUSINESS_OWNER
  SUPER_ADMIN
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  LOCKED
  DELETED
}

enum BusinessStatus {
  PENDING
  ACTIVE
  SUSPENDED
  CLOSED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum CouponType {
  PERCENT
  FIXED
}

enum CouponScope {
  PLATFORM
  BUSINESS
}

enum LoyaltyTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

enum LoyaltyTxType {
  EARN
  REDEEM
  EXPIRE
  ADJUST
}

enum ReferralStatus {
  PENDING
  COMPLETED
  REWARDED
}

enum NotificationType {
  SYSTEM
  BOOKING
  PAYMENT
  MESSAGE
  REVIEW
  PROMOTION
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
}

enum ReviewStatus {
  PENDING
  PUBLISHED
  HIDDEN
}

enum FileProvider {
  LOCAL
  S3
}

enum AuditAction {
  CREATE
  READ
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  EXPORT
  APPROVE
  REJECT
}

enum SettingScope {
  GLOBAL
  BUSINESS
  USER
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  VOID
  OVERDUE
}

// ------------------------------------------------------------
// Identity & Access (RBAC)
// ------------------------------------------------------------

model User {
  id                   String     @id @default(cuid())
  email                String     @unique
  emailVerified        DateTime?
  phone                String?    @unique
  passwordHash         String?
  firstName            String?
  lastName             String?
  name                 String?
  avatarUrl            String?
  bio                  String?
  address              String?
  countryId            String?
  cityId               String?
  notificationSettings Json?      @default("{\"email\":true,\"push\":true,\"sms\":false}")
  referralCode         String?    @unique
  status               UserStatus @default(PENDING)
  failedLoginAttempts  Int        @default(0)
  lockedUntil          DateTime?
  mfaEnabled           Boolean    @default(false)
  mfaSecret            String?
  preferredLanguage    String     @default("ar")
  preferredTheme       String     @default("system")
  timezone             String     @default("Asia/Baghdad")
  lastLoginAt          DateTime?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  roles    UserRole[]
  accounts Account[]
  sessions Session[]
  devices  Device[]

  country         Country?                @relation(fields: [countryId], references: [id], onDelete: SetNull)
  city            City?                   @relation(fields: [cityId], references: [id], onDelete: SetNull)
  favorites       Favorite[]
  deletionRequest AccountDeletionRequest?

  // Ownership
  businessesOwned Business[] @relation("BusinessOwner")
  employeeProfile Employee?

  // Bookings
  bookings      Booking[]          @relation("BookingCustomer")
  couponUses    CouponRedemption[]
  loyalty       LoyaltyAccount?
  sentReferrals Referral[]         @relation("ReferralReferrer")
  gotReferred   Referral[]         @relation("ReferralReferee")

  // Messaging / reviews
  reviews       Review[]
  sentMessages  Message[]      @relation("MessageSender")
  gotMessages   Message[]      @relation("MessageRecipient")
  notifications Notification[]

  // Billing / files
  invoices       Invoice[]
  paymentRecords PaymentRecord[]
  files          File[]
  settings       Setting[]
  auditLogs      AuditLog[]
  activityLogs   ActivityLog[]
  resetTokens    PasswordResetToken[]
  refreshTokens  RefreshToken[]

  @@index([email])
  @@index([status])
  @@map("users")
}

model Role {
  id          String   @id @default(cuid())
  name        RoleName @unique
  description String?
  createdAt   DateTime @default(now())

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())
  assignedBy String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// Auth.js adapter tables
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ------------------------------------------------------------
// Catalog
// ------------------------------------------------------------

model Category {
  id          String   @id @default(cuid())
  name        String
  nameAr      String
  slug        String   @unique
  description String?
  icon        String?
  coverUrl    String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parentId   String?
  parent     Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children   Category[] @relation("CategoryTree")
  businesses Business[]

  @@map("categories")
}

model Language {
  id         String  @id @default(cuid())
  code       String  @unique
  name       String
  nameNative String
  dir        String  @default("ltr")
  isActive   Boolean @default(true)
  isDefault  Boolean @default(false)

  @@map("languages")
}

model Country {
  id        String  @id @default(cuid())
  code      String  @unique
  name      String
  nameAr    String
  phoneCode String
  currency  String  @default("USD")
  isActive  Boolean @default(true)

  cities     City[]
  businesses Business[]
  users      User[]

  @@map("countries")
}

model City {
  id        String  @id @default(cuid())
  countryId String
  name      String
  nameAr    String
  isActive  Boolean @default(true)

  country    Country    @relation(fields: [countryId], references: [id], onDelete: Cascade)
  businesses Business[]
  branches   Branch[]
  users      User[]

  @@index([countryId])
  @@map("cities")
}

// ------------------------------------------------------------
// Business domain
// ------------------------------------------------------------

model Business {
  id          String         @id @default(cuid())
  ownerId     String
  name        String
  nameAr      String?
  slug        String         @unique
  description String?
  logoUrl     String?
  coverUrl    String?
  phone       String?
  email       String?
  website     String?
  address     String?
  status      BusinessStatus @default(PENDING)
  rating      Float          @default(0)
  reviewCount Int            @default(0)
  latitude    Float?
  longitude   Float?
  socialLinks Json?
  verified    Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  countryId  String?
  country    Country?  @relation(fields: [countryId], references: [id], onDelete: SetNull)
  cityId     String?
  city       City?     @relation(fields: [cityId], references: [id], onDelete: SetNull)

  owner        User            @relation("BusinessOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  favoritedBy  Favorite[]
  branches     Branch[]
  services     Service[]
  employees    Employee[]
  bookings     Booking[]
  reviews      Review[]
  subscription Subscription?
  coupons      Coupon[]
  images       Image[]
  files        File[]
  settings     Setting[]
  hours        BusinessHour[]
  aiSettings   AiSetting?
  invoices     Invoice[]
  payments     PaymentRecord[]

  @@index([ownerId])
  @@index([categoryId])
  @@index([cityId])
  @@index([status])
  @@map("businesses")
}

model Branch {
  id           String         @id @default(cuid())
  businessId   String
  name         String
  nameAr       String?
  address      String?
  phone        String?
  isMain       Boolean        @default(false)
  status       BusinessStatus @default(ACTIVE)
  latitude     Float?
  longitude    Float?
  workingHours Json?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  cityId String?
  city   City?   @relation(fields: [cityId], references: [id], onDelete: SetNull)

  business  Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  employees Employee[]
  services  Service[]
  bookings  Booking[]
  hours     BusinessHour[]

  @@index([businessId])
  @@map("branches")
}

model Service {
  id              String   @id @default(cuid())
  businessId      String
  branchId        String?
  name            String
  nameAr          String?
  description     String?
  price           Decimal  @db.Decimal(12, 2)
  currency        String   @default("USD")
  durationMinutes Int      @default(30)
  imageUrl        String?
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch   Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)

  employees ServiceEmployee[]
  bookings  Booking[]

  @@index([businessId])
  @@map("services")
}

model Employee {
  id           String   @id @default(cuid())
  businessId   String
  branchId     String?
  userId       String?  @unique
  name         String
  title        String?
  bio          String?
  avatarUrl    String?
  isActive     Boolean  @default(true)
  workingHours Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch   Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  services ServiceEmployee[]
  bookings Booking[]

  @@index([businessId])
  @@map("employees")
}

model ServiceEmployee {
  serviceId  String
  employeeId String
  assignedAt DateTime @default(now())

  service  Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@id([serviceId, employeeId])
  @@map("service_employees")
}

model BusinessHour {
  id         String  @id @default(cuid())
  businessId String
  branchId   String?
  dayOfWeek  Int
  opensAt    String
  closesAt   String
  isClosed   Boolean @default(false)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch   Branch?  @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@map("business_hours")
}

// ------------------------------------------------------------
// Bookings (schema ready — logic comes in Phase 2)
// ------------------------------------------------------------

model Booking {
  id           String        @id @default(cuid())
  reference    String        @unique
  customerId   String
  businessId   String
  branchId     String?
  serviceId    String
  employeeId   String?
  startAt      DateTime
  endAt        DateTime
  status       BookingStatus @default(PENDING)
  price        Decimal       @db.Decimal(12, 2)
  currency     String        @default("USD")
  notes        String?
  cancelReason String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  customer User      @relation("BookingCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch   Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  service  Service   @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  employee Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  review     Review?
  payments   PaymentRecord[]
  couponUses CouponRedemption[]
  invoice    Invoice?

  @@index([customerId])
  @@index([businessId])
  @@index([status])
  @@index([startAt])
  @@map("bookings")
}

model Review {
  id              String       @id @default(cuid())
  bookingId       String?      @unique
  businessId      String
  customerId      String
  rating          Int
  comment         String?
  status          ReviewStatus @default(PENDING)
  businessReply   String?
  businessReplyAt DateTime?
  createdAt       DateTime     @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer User     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  booking  Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([customerId])
  @@map("reviews")
}

// ------------------------------------------------------------
// Messaging & Notifications
// ------------------------------------------------------------

model Message {
  id          String        @id @default(cuid())
  senderId    String
  recipientId String
  subject     String?
  body        String
  status      MessageStatus @default(SENT)
  isRead      Boolean       @default(false)
  readAt      DateTime?
  createdAt   DateTime      @default(now())

  sender    User @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([recipientId])
  @@map("messages")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType @default(SYSTEM)
  title     String
  body      String?
  data      Json?
  isRead    Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

// ------------------------------------------------------------
// Monetization
// ------------------------------------------------------------

model Plan {
  id           String   @id @default(cuid())
  name         String
  nameAr       String
  description  String?
  priceMonthly Decimal  @db.Decimal(12, 2)
  priceYearly  Decimal  @db.Decimal(12, 2)
  currency     String   @default("USD")
  maxBranches  Int      @default(1)
  maxEmployees Int      @default(5)
  maxServices  Int      @default(10)
  features     Json?
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id                 String             @id @default(cuid())
  businessId         String             @unique
  planId             String
  status             SubscriptionStatus @default(TRIAL)
  billingCycle       BillingCycle       @default(MONTHLY)
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  plan     Plan     @relation(fields: [planId], references: [id], onDelete: Restrict)

  invoices Invoice[]

  @@index([status])
  @@map("subscriptions")
}

model Coupon {
  id           String      @id @default(cuid())
  code         String      @unique
  type         CouponType
  scope        CouponScope @default(PLATFORM)
  value        Decimal     @db.Decimal(12, 2)
  minOrder     Decimal?    @db.Decimal(12, 2)
  maxUses      Int?
  usedCount    Int         @default(0)
  perUserLimit Int         @default(1)
  startsAt     DateTime?
  expiresAt    DateTime?
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())

  businessId String?
  business   Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)

  redemptions CouponRedemption[]

  @@index([code])
  @@map("coupons")
}

model CouponRedemption {
  id        String   @id @default(cuid())
  couponId  String
  userId    String
  bookingId String?
  usedAt    DateTime @default(now())

  coupon  Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@unique([couponId, userId])
  @@map("coupon_redemptions")
}

model LoyaltyAccount {
  id             String      @id @default(cuid())
  userId         String      @unique
  pointsBalance  Int         @default(0)
  lifetimePoints Int         @default(0)
  tier           LoyaltyTier @default(BRONZE)
  updatedAt      DateTime    @updatedAt

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions LoyaltyTransaction[]

  @@map("loyalty_accounts")
}

model LoyaltyTransaction {
  id          String        @id @default(cuid())
  accountId   String
  points      Int
  type        LoyaltyTxType
  reference   String?
  description String?
  createdAt   DateTime      @default(now())

  account LoyaltyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@map("loyalty_transactions")
}

model Referral {
  id            String         @id @default(cuid())
  referrerId    String
  refereeId     String         @unique
  code          String         @unique
  status        ReferralStatus @default(PENDING)
  rewardGranted Boolean        @default(false)
  createdAt     DateTime       @default(now())

  referrer User @relation("ReferralReferrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referee  User @relation("ReferralReferee", fields: [refereeId], references: [id], onDelete: Cascade)

  @@index([referrerId])
  @@map("referrals")
}

// ------------------------------------------------------------
// Billing (schema ready — logic comes later)
// ------------------------------------------------------------

model PaymentRecord {
  id          String        @id @default(cuid())
  bookingId   String?
  userId      String
  businessId  String?
  amount      Decimal       @db.Decimal(12, 2)
  currency    String        @default("USD")
  method      String?
  status      PaymentStatus @default(PENDING)
  provider    String?
  providerRef String?
  createdAt   DateTime      @default(now())

  booking  Booking?  @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)

  @@index([bookingId])
  @@index([userId])
  @@map("payment_records")
}

model Invoice {
  id             String        @id @default(cuid())
  invoiceNumber  String        @unique
  userId         String?
  businessId     String?
  subscriptionId String?
  bookingId      String?       @unique
  amount         Decimal       @db.Decimal(12, 2)
  currency       String        @default("USD")
  status         InvoiceStatus @default(DRAFT)
  dueAt          DateTime?
  paidAt         DateTime?
  pdfUrl         String?
  createdAt      DateTime      @default(now())

  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  business     Business?     @relation(fields: [businessId], references: [id], onDelete: SetNull)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  booking      Booking?      @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@map("invoices")
}

// ------------------------------------------------------------
// Files & Media
// ------------------------------------------------------------

model File {
  id         String       @id @default(cuid())
  ownerId    String?
  businessId String?
  bucket     String
  key        String
  url        String
  mimeType   String
  size       Int
  provider   FileProvider @default(LOCAL)
  isPublic   Boolean      @default(false)
  createdAt  DateTime     @default(now())

  owner    User?     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  business Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  images   Image[]

  @@index([businessId])
  @@map("files")
}

model Image {
  id         String   @id @default(cuid())
  businessId String?
  fileId     String?
  entityType String?
  entityId   String?
  url        String
  alt        String?
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  business Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  file     File?     @relation(fields: [fileId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@map("images")
}

// ------------------------------------------------------------
// Settings, Logs & AI
// ------------------------------------------------------------

model Setting {
  id         String       @id @default(cuid())
  key        String
  value      Json
  scope      SettingScope @default(GLOBAL)
  userId     String?
  businessId String?
  updatedAt  DateTime     @updatedAt

  user     User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([key, scope, userId, businessId])
  @@map("settings")
}

model AuditLog {
  id         String      @id @default(cuid())
  userId     String?
  actorEmail String?
  action     AuditAction
  entity     String
  entityId   String?
  ip         String?
  userAgent  String?
  metadata   Json?
  createdAt  DateTime    @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entity])
  @@index([createdAt])
  @@map("audit_logs")
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String?
  type      String
  message   String
  metadata  Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([type])
  @@map("activity_logs")
}

model Device {
  id           String   @id @default(cuid())
  userId       String
  name         String
  userAgent    String?
  ip           String?
  lastActiveAt DateTime @default(now())
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("devices")
}

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  businessId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId])
  @@index([businessId])
  @@map("favorites")
}

model AccountDeletionRequest {
  id          String    @id @default(cuid())
  userId      String    @unique
  reason      String?
  status      String    @default("PENDING") // PENDING | PROCESSED | CANCELLED
  requestedAt DateTime  @default(now())
  processedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account_deletion_requests")
}

model AiSetting {
  id                    String   @id @default(cuid())
  businessId            String   @unique
  enableAutoReply       Boolean  @default(false)
  enableRecommendations Boolean  @default(false)
  enableChatAssistant   Boolean  @default(false)
  tone                  String   @default("professional")
  language              String   @default("ar")
  promptTemplate        String?
  updatedAt             DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("ai_settings")
}
