# ============================================================
# احجزلي — Environment configuration (Phase 1)
# Copy this file to `.env` and fill in real values.
# NEVER commit a real `.env` file.
# ============================================================

# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/ahjezli?schema=public"

# --- Auth.js / NextAuth ---
AUTH_SECRET="generate-with: openssl rand -base64 32"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# --- OAuth (optional) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Apple & phone sign-in are prepared at the schema level (Phase 3).

# --- Realtime (prepared) ---
SOCKET_PORT="4000"
NEXT_PUBLIC_SOCKET_URL="http://localhost:4000"

# --- JWT (access + refresh) ---
JWT_ACCESS_SECRET="generate-with: openssl rand -base64 32"
JWT_REFRESH_SECRET="generate-with: openssl rand -base64 32"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# --- Email (verification / password reset) ---
EMAIL_FROM="no-reply@ahjezli.app"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="احجزلي"
